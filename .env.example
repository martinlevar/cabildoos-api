# Copiá este archivo como .env y completá los valores

# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...  # Service role key (NO la anon key)

# Gemini
GEMINI_API_KEY=AIza...

# CORS — dominio del frontend
FRONTEND_ORIGIN=https://cabildoos.pages.dev

# Salt para hash de documentos — generá uno aleatorio y nunca lo cambies
# Si lo cambiás, todos los hashes existentes quedan inválidos (duplicados no detectados)
# Ejemplo: openssl rand -hex 32
DOC_HASH_SALT=cambia-esto-por-un-string-aleatorio-largo

# Entorno
ENVIRONMENT=production
